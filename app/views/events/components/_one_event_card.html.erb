<%= link_to event_path(event), class: "block group", data: { turbo_frame: "_top" } do %>
  <div class="ff-card text-left transition duration-150 active:scale-[0.98] min-h-50 hover:bg-surface-hover">
    <div class="flex justify-between items-start mb-4 gap-3">
      <h2 class="text-xl text-white truncate font-semibold"><%= event.title %></h2>
      <span class="ff-badge shrink-0">
        <%= render "events/components/svg/lock" if event.is_private %>
        <%= render "events/components/svg/unlock" unless event.is_private %>
      </span>
    </div>

    <div class="space-y-2 text-secondary-text">
      <div class="flex items-center gap-2">
        <%= render "events/components/svg/calendar" %>
        <p><%= human_future_date(event.start_time) %></p>
      </div>

      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
        </svg>
        <span><%= event.location %></span>
      </div>

      <div class="flex items-center gap-2">
        <%= render "events/components/svg/people" %>
        <%= event_fill_badge(event) %>
      </div>

      <div class="flex items-center gap-2">
        <%= render "events/components/svg/dollar" %>
        <% if event.price.zero? %>
          <span><%= t("events.labels.free") %></span>
        <% else %>
          <span><%= format_event_price(event.price) %></span>
        <% end %>
      </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-4">
      <p class="ff-meta"><%= event.user.first_name %></p>
      <div class="size-12 rounded-full overflow-hidden border border-border">
        <% if event.user.avatar? %>
          <%= cl_image_tag event.user.avatar, class: "size-12 rounded-full object-cover" %>
        <% else %>
          <%= image_tag "placeholder-avatar.png", class: "size-12 rounded-full ff-avatar-fallback p-1" %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
