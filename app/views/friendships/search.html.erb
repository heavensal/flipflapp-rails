<main class="min-h-dvh px-4" role="main">
  <h1 class="text-3xl font-bold text-white text-center my-8">
    <%= t("friendships.titles.search") %>
  </h1>

  <%= link_to t("friendships.actions.back"), friendships_path,
      class: "btn-secondary-sm mb-4",
      aria: { label: t("friendships.aria.back") } %>

  <!-- Formulaire de recherche -->
  <section class="mb-8">
    <div class="ff-card-lg">
      <%= search_form_for @q, url: search_friendships_path, html: { class: "flex", role: "search" } do |f| %>
      <%= f.label :first_name_or_last_name_or_username_cont, t("friendships.labels.search_field"), class: "sr-only" %>
      <%= f.search_field :first_name_or_last_name_or_username_cont,
              placeholder: t("friendships.placeholders.search"),
              aria: { label: t("friendships.aria.search_field") },
              class: "form-text-input flex-grow !rounded-e-none" %>

        <%= f.button type: "submit",
              class: "bg-accent px-4 rounded-e-xl flex items-center justify-center text-form-green hover:bg-accent-strong transition-colors",
              aria: { label: t("friendships.aria.search_submit") } do %>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            role="img"
            aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1110.5 3a7.5 7.5 0 016.15 13.65z" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </section>

  <!-- Résultats de recherche -->
  <section class="my-8">
    <div id="header-search-results" class="grid grid-cols-6 gap-1 mb-4 items-center">
      <div class="col-span-1 place-self-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-6 text-secondary-text"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          role="img"
          aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <h2 class="text-xl col-span-4 text-white">
        <%= t("friendships.titles.results") %>
      </h2>

      <% if @users&.any? && @q.present? %>
        <div class="col-span-1 place-self-center">
          <span class="ff-badge-accent size-6">
            <%= @users.count %>
          </span>
        </div>
      <% end %>
    </div>

    <% if params[:q].blank? %>
      <div class="text-center py-8 text-secondary-text">
        <p><%= t("friendships.empty.search_prompt") %></p>
      </div>
    <% elsif @users.empty? && @q.present? %>
      <div class="text-center py-8 text-secondary-text">
        <p><%= t("friendships.empty.search_results") %></p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 gap-3">
        <% @users.each do |user| %>
          <div class="ff-list-row">
            <div class="grid grid-cols-6 items-center gap-2">
              <!-- Avatar -->
              <div class="size-10 rounded-full col-span-1 place-self-center ring-2 ring-accent/40">
                <div class="w-full h-full rounded-full overflow-hidden ff-avatar-fallback flex items-center justify-center">
                  <% if user.avatar? %>
                    <%= cl_image_tag user.avatar,
                        class: "w-full h-full object-cover rounded-full",
                        alt: "#{user.first_name} #{user.last_name}" %>
                  <% else %>
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 0.6 0.6"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="currentColor"
                      class="text-secondary-text"
                      role="img"
                      aria-label="<%= t("friendships.aria.default_avatar") %>">
                      <path d="M.44.06a.06.06 0 1 1-.12 0 .06.06 0 0 1 .12 0m0 .38a.04.04 0 1 0 0 .08.04.04 0 0 0 0-.08M.514.244.438.168A.02.02 0 0 0 .423.161H.14a.02.02 0 0 0 0 .04h.108L.12.452V.46a.02.02 0 0 0 .04.008L.2.4h.08L.203.57.2.58a.02.02 0 0 0 .04.008L.428.213l.058.059A.02.02 0 0 0 .514.244"/>
                    </svg>
                  <% end %>
                </div>
              </div>

              <!-- Informations utilisateur -->
              <ul class="col-span-4">
                <%= link_to user_path(user), class: "focus:outline-none focus:ring-2 focus:ring-accent rounded" do %>
                  <li class="font-semibold text-white">
                    <%= user.first_name %> <%= user.last_name %>
                  </li>
                  <li class="text-secondary-text text-sm">
                    @<%= user.username %>
                  </li>
                <% end %>
              </ul>

              <!-- Bouton d'ajout d'ami -->
              <div class="col-span-1 place-self-center">
                <%= button_to friendships_path, params: { user_id: user.id },
                      class: "btn-primary-sm !p-2",
                      aria: { label: t("friendships.aria.add_friend", name: user.first_name) } do %>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="size-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    role="img"
                    aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

</main>
