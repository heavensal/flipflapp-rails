<main class="flex-1 p-4 sm:px-8">
  <%= render "pages/components/carrousel_container" %>

  <section class="min-h-screen p-4">
    <div class="max-w-md mx-auto text-center pt-8">
      <h2 class="text-3xl text-white mb-4"><%= t("pages.titles.home") %></h2>
      <p class="text-secondary-text mb-8">
        <%= t("pages.labels.home_description") %>
      </p>

      <div class="flex flex-col gap-3">
        <%= link_to t("pages.actions.sign_up"),
              new_user_registration_path,
              class: "btn-primary w-full" %>
        <%= link_to t("pages.actions.sign_in"),
              new_user_session_path,
              class: "btn-secondary w-full" %>
      </div>
    </div>
  </section>
</main>
